# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있으므로 절대 커밋되지 않습니다.

# Django 시크릿 키 (필수)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# 업비트 Open API 키 (필수)
# 발급: https://upbit.com/mypage/open_api_management
# - "자산 조회" + "주문하기" 권한 필요
# - 접속 허용 IP 등록 필수
UPBIT_API_KEY=
UPBIT_SECRET_KEY=
